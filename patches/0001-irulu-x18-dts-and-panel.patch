@@ -1113,6 +1113,269 @@
 	.enter_sleep_to_reset_down_delay_ms = 100,
 };
 
+static int irulu_x18_init_cmds(struct jadard *jadard)
+{
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = jadard->dsi };
+
+	/* Taken from the vendor BSP (disp.ko, LCM_LT080B21BA94_setting) */
+	mipi_dsi_dcs_soft_reset_multi(&dsi_ctx);
+	mipi_dsi_msleep(&dsi_ctx, 10);
+
+	jd9365da_switch_page(&dsi_ctx, 0x00);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xE1, 0x93);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xE2, 0x65);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xE3, 0xF8);
+
+	jd9365da_switch_page(&dsi_ctx, 0x00);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x70, 0x02);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x71, 0x23);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x72, 0x06);
+
+	jd9365da_switch_page(&dsi_ctx, 0x01);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x00, 0x00);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x01, 0xA0);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x03, 0x00);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x04, 0xA0);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x17, 0x00);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x18, 0xB1);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x19, 0x00);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x1A, 0x00);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x1B, 0xB1);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x1C, 0x00);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x1F, 0x48);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x20, 0x23);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x21, 0x23);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x22, 0x0E);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x23, 0x00);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x24, 0x38);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x26, 0xD3);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x37, 0x59);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x38, 0x05);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x39, 0x08);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x3A, 0x12);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x3C, 0x78);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x3E, 0x80);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x3F, 0x80);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x40, 0x06);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x41, 0xA0);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x55, 0x0F);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x56, 0x01);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x57, 0x85);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x58, 0x0A);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x59, 0x0A);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x5A, 0x32);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x5B, 0x0F);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x5D, 0x7C);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x5E, 0x62);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x5F, 0x50);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x60, 0x42);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x61, 0x3D);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x62, 0x2D);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x63, 0x30);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x64, 0x19);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x65, 0x30);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x66, 0x2E);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x67, 0x2D);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x68, 0x4A);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x69, 0x3A);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x6A, 0x43);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x6B, 0x37);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x6C, 0x37);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x6D, 0x2D);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x6E, 0x1F);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x6F, 0x00);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x70, 0x7C);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x71, 0x62);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x72, 0x50);
