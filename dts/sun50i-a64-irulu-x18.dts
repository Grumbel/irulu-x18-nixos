// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
/*
 * iRULU X18 8" tablet, sold as "iRULU eXpro X1S" (Allwinner A64, AXP803,
 * JD9365 MIPI-DSI panel, Silead GSL touch, RTL8723BS Wi-Fi/BT)
 *
 * Derived from the vendor's Android 5.1 (Linux 3.10 BSP) device tree and
 * the runtime state of the stock firmware. Remaining TODOs are untested
 * parts (accelerometer, cameras, keys).
 */

/dts-v1/;

#include "sun50i-a64.dtsi"
#include "sun50i-a64-cpu-opp.dtsi"

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/pwm/pwm.h>

/ {
	model = "iRULU X18";
	compatible = "irulu,x18", "allwinner,sun50i-a64";

	aliases {
		serial0 = &uart0;
		ethernet0 = &rtl8723bs;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	/* Values from the vendor sys_config (pmu0 node) */
	battery: battery {
		compatible = "simple-battery";
		charge-full-design-microamp-hours = <4000000>;	/* pmu_battery_cap */
		voltage-min-design-microvolt = <3300000>;	/* pmu_pwroff_vol */
		voltage-max-design-microvolt = <4200000>;	/* pmu_init_chgvol */
		constant-charge-current-max-microamp = <1800000>; /* pmu_suspend_chgcur */
		constant-charge-voltage-max-microvolt = <4200000>;
	};

	backlight: backlight {
		compatible = "pwm-backlight";
		/* BSP: lcd_pwm_ch=0, lcd_pwm_freq=50000 Hz, lcd_pwm_pol=1 */
		pwms = <&pwm 0 20000 PWM_POLARITY_INVERTED>;
		enable-gpios = <&pio 3 23 GPIO_ACTIVE_HIGH>; /* PD23 lcd_bl_en */
		brightness-levels = <0 1000>;
		num-interpolated-steps = <1000>;
		default-brightness-level = <400>;
	};

	speaker_amp: audio-amplifier {
		compatible = "simple-audio-amplifier";
		enable-gpios = <&pio 7 7 GPIO_ACTIVE_HIGH>; /* PH7 gpio-spk */
		sound-name-prefix = "Speaker Amp";
	};

	/*
	 * WL_REG_ON as a regulator instead of mmc-pwrseq-simple: on 6.18 the
	 * latter fails with "reset control not ready" (-ENOENT) for a single
	 * reset GPIO.
	 */
	reg_wl_reg_on: regulator-wl-reg-on {
		compatible = "regulator-fixed";
		regulator-name = "wl-reg-on";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		vin-supply = <&reg_dldo4>;
		gpio = <&r_pio 0 2 GPIO_ACTIVE_HIGH>; /* PL2 wlan_regon */
		enable-active-high;
		startup-delay-us = <200000>;
	};
};

&codec {
	status = "okay";
};

&codec_analog {
	cpvdd-supply = <&reg_eldo1>;
	status = "okay";
};

&cpu0 {
	cpu-supply = <&reg_dcdc2>;
};

&cpu1 {
	cpu-supply = <&reg_dcdc2>;
};

&cpu2 {
	cpu-supply = <&reg_dcdc2>;
};

&cpu3 {
	cpu-supply = <&reg_dcdc2>;
};

&dai {
	status = "okay";
};

&de {
	status = "okay";
};

&dphy {
	status = "okay";
};

&dsi {
	vcc-dsi-supply = <&reg_dldo1>; /* vcc-dsi-33 */
	status = "okay";

	panel@0 {
		/*
		 * LT080B21BA94, 800x1280, 4-lane DSI, Jadard JD9365 controller.
		 * Needs patches/0001-drm-panel-jadard-add-iRULU-X18-panel.patch.
		 */
		compatible = "irulu,x18-panel", "jadard,jd9365da-h3";
		reg = <0>;
		reset-gpios = <&pio 3 24 GPIO_ACTIVE_LOW>; /* PD24 lcd_gpio_1 */
		vdd-supply = <&reg_dldo2>;	/* vcc-lcd 3.3V */
		vccio-supply = <&reg_eldo2>;	/* vcc-mipi 1.8V */
		backlight = <&backlight>;
	};
};

/*
 * ehci0/ohci0 share PHY 0 with the OTG controller. Enabling them makes the
 * USB core switch PHY 0 to host mode ("Changing dr_mode to 1"), which kills
 * peripheral mode. Leave them disabled while usb_otg is peripheral-only.
 */

&ehci1 {
	status = "okay";
};

&i2c0 {
	pinctrl-names = "default";
	pinctrl-0 = <&i2c0_pins>; /* PH0/PH1 */
	status = "okay";

	touchscreen@40 {
		compatible = "silead,gsl1680";
		reg = <0x40>;
		interrupt-parent = <&pio>;
		interrupts = <7 4 IRQ_TYPE_EDGE_FALLING>; /* PH4 ctp_int_port */
		power-gpios = <&pio 7 8 GPIO_ACTIVE_HIGH>; /* PH8 ctp_wakeup */
		vddio-supply = <&reg_ldo_io0>; /* vcc-ctp */
		firmware-name = "gsl1680-irulu-x18.fw";
		/*
		 * Raw chip axes (before the swap), measured with evtest:
		 * raw X = vertical 35..1698, raw Y = horizontal 0..1151.
		 * The firmware doesn't scale to the 800x1280 panel.
		 */
		touchscreen-min-x = <35>;
		touchscreen-size-x = <1699>;
		touchscreen-size-y = <1152>;
		touchscreen-swapped-x-y;
		silead,max-fingers = <10>;
	};
};

&i2c1 {
	pinctrl-names = "default";
	pinctrl-0 = <&i2c1_pins>; /* PH2/PH3 */
	status = "okay";

	/*
	 * MiraMEMS "mir3da" accelerometer (BSP DT says 0x1d, the chip is at
	 * 0x27). Chip ID 0x13 and register map as DA280. Its interrupt on
	 * PH5 is left out: the da280 driver only polls.
	 */
	accelerometer@27 {
		compatible = "miramems,da280";
		reg = <0x27>;
	};
};

&lradc {
	vref-supply = <&reg_aldo3>;
	status = "okay";

	/*
	 * BSP "keyboard_2000mv" upper thresholds in mV:
	 * 240 VOLUMEUP, 500 VOLUMEDOWN, 700 MENU, 890 ENTER, 2000 HOME.
	 * TODO: measure real voltages, the tablet likely only has vol+/vol-.
	 */
	button-200 {
		label = "Volume Up";
		linux,code = <KEY_VOLUMEUP>;
		channel = <0>;
		voltage = <200000>;
	};

	button-400 {
		label = "Volume Down";
		linux,code = <KEY_VOLUMEDOWN>;
		channel = <0>;
		voltage = <400000>;
	};
};

&mixer0 {
	status = "okay";
};

&mmc0 {
	vmmc-supply = <&reg_dcdc1>; /* vcc-sdc */
	cd-gpios = <&pio 5 6 GPIO_ACTIVE_LOW>; /* PF6 */
	disable-wp;
	bus-width = <4>;
	status = "okay";
};

&mmc1 {
	pinctrl-names = "default";
	pinctrl-0 = <&mmc1_pins>;
	vmmc-supply = <&reg_wl_reg_on>; /* vcc-wifi-io, switched by WL_REG_ON */
	vqmmc-supply = <&reg_dldo4>; /* vcc-pg */
	bus-width = <4>;
	non-removable;
	status = "okay";

	rtl8723bs: wifi@1 {
		reg = <1>;
		interrupt-parent = <&r_pio>;
		interrupts = <0 3 IRQ_TYPE_LEVEL_LOW>; /* PL3 wlan_hostwake */
		interrupt-names = "host-wake";
	};
};

/* The internal raw NAND (Allwinner proprietary FTL) is not usable. */

&ohci1 {
	status = "okay";
};

&pio {
	vcc-pb-supply = <&reg_dcdc1>;
	vcc-pc-supply = <&reg_eldo1>;	/* BSP: eldo1 -> vcc-pc */
	vcc-pd-supply = <&reg_dcdc1>;
	vcc-pe-supply = <&reg_aldo1>;	/* TODO: CSI bank, unverified */
	vcc-pf-supply = <&reg_dcdc1>;
	vcc-pg-supply = <&reg_dldo4>;
	vcc-ph-supply = <&reg_dcdc1>;
};

&pwm {
	status = "okay";
};

&r_rsb {
	status = "okay";

	/* BSP: pmu_id=6 (AXP81x family), axp81x regulators */
	axp803: pmic@3a3 {
		compatible = "x-powers,axp803";
		reg = <0x3a3>;
		interrupt-parent = <&r_intc>;
		interrupts = <GIC_SPI 32 IRQ_TYPE_LEVEL_LOW>;
		x-powers,drive-vbus-en;
	};
};

#include "axp803.dtsi"

&ac_power_supply {
	status = "okay";
};

/* Required by usbphy (usb0_vbus_power-supply), otherwise USB never probes */
&usb_power_supply {
	status = "okay";
};

&battery_power_supply {
	monitored-battery = <&battery>;
	status = "okay";
};

&reg_aldo1 {
	regulator-min-microvolt = <2800000>;
	regulator-max-microvolt = <2800000>;
	regulator-name = "iovdd-csi";
};

&reg_aldo2 {
	regulator-always-on;
	regulator-min-microvolt = <1800000>;
	regulator-max-microvolt = <1800000>;
	regulator-name = "vcc-pl";
};

&reg_aldo3 {
	regulator-always-on;
	regulator-min-microvolt = <3000000>;
	regulator-max-microvolt = <3000000>;
	regulator-name = "vcc-pll-avcc";
};

&reg_dc1sw {
	regulator-name = "vcc-dc1sw";
};

&reg_dcdc1 {
	regulator-always-on;
	regulator-min-microvolt = <3300000>;
	regulator-max-microvolt = <3300000>;
	regulator-name = "vcc-3v3";
};

&reg_dcdc2 {
	regulator-always-on;
	regulator-min-microvolt = <1000000>;
	regulator-max-microvolt = <1300000>;
	regulator-name = "vdd-cpux";
};

/* BSP shows dcdc3 enabled at 1.1V with no users; left alone like on the PineTab. */

&reg_dcdc5 {
	regulator-always-on;
	regulator-min-microvolt = <1500000>; /* DDR3 (not DDR3L) */
	regulator-max-microvolt = <1500000>;
	regulator-name = "vcc-dram";
};

&reg_dcdc6 {
	regulator-always-on;
	regulator-min-microvolt = <1100000>;
	regulator-max-microvolt = <1100000>;
	regulator-name = "vdd-sys";
};

&reg_dldo1 {
	regulator-min-microvolt = <3300000>;
	regulator-max-microvolt = <3300000>;
	regulator-name = "vcc-dsi-hdmi";
};

&reg_dldo2 {
	regulator-min-microvolt = <3300000>;
	regulator-max-microvolt = <3300000>;
	regulator-name = "vcc-lcd";
};

&reg_dldo3 {
	regulator-min-microvolt = <2800000>;
	regulator-max-microvolt = <2800000>;
	regulator-name = "avdd-csi";
};

&reg_dldo4 {
	regulator-min-microvolt = <3300000>;
	regulator-max-microvolt = <3300000>;
	regulator-name = "vcc-wifi-io";
};

&reg_drivevbus {
	regulator-name = "usb0-vbus";
	status = "okay";
};

&reg_eldo1 {
	regulator-always-on;
	regulator-min-microvolt = <1800000>;
	regulator-max-microvolt = <1800000>;
	regulator-name = "cpvdd";
};

&reg_eldo2 {
	regulator-min-microvolt = <1800000>;
	regulator-max-microvolt = <1800000>;
	regulator-name = "vcc-mipi";
};

&reg_eldo3 {
	regulator-min-microvolt = <1800000>;
	regulator-max-microvolt = <1800000>;
	regulator-name = "dvdd-csi";
};

&reg_fldo1 {
	regulator-min-microvolt = <1200000>;
	regulator-max-microvolt = <1200000>;
	regulator-name = "vcc-1v2-hsic";
};

&reg_fldo2 {
	regulator-always-on;
	regulator-min-microvolt = <1100000>;
	regulator-max-microvolt = <1100000>;
	regulator-name = "vdd-cpus";
};

&reg_ldo_io0 {
	regulator-min-microvolt = <3300000>;
	regulator-max-microvolt = <3300000>;
	regulator-name = "vcc-ctp";
	status = "okay";
};

&reg_rtc_ldo {
	regulator-name = "vcc-rtc";
};

&sound {
	simple-audio-card,aux-devs = <&codec_analog>, <&speaker_amp>;
	simple-audio-card,widgets = "Microphone", "Internal Microphone",
				    "Headphone", "Headphone Jack",
				    "Speaker", "Internal Speaker";
	simple-audio-card,routing =
			"Left DAC", "DACL",
			"Right DAC", "DACR",
			"Speaker Amp INL", "LINEOUT",
			"Speaker Amp INR", "LINEOUT",
			"Internal Speaker", "Speaker Amp OUTL",
			"Internal Speaker", "Speaker Amp OUTR",
			"Headphone Jack", "HP",
			"ADCL", "Left ADC",
			"ADCR", "Right ADC",
			"Internal Microphone", "MBIAS",
			"MIC1", "Internal Microphone";
	status = "okay";
};

/* Debug UART: PB8/PB9 test pads, or PF2/PF4 via a microSD breakout */
&uart0 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart0_pb_pins>;
	status = "okay";
};

&uart1 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart1_pins>, <&uart1_rts_cts_pins>;
	uart-has-rtscts;
	status = "okay";

	bluetooth {
		compatible = "realtek,rtl8723bs-bt";
		enable-gpios = <&r_pio 0 4 GPIO_ACTIVE_HIGH>; /* PL4 bt_rst_n */
	};
};

&usb_otg {
	/*
	 * Forced to peripheral for headless bring-up (USB ethernet gadget).
	 * Switch back to "otg" once the ID pin handling is verified.
	 */
	dr_mode = "peripheral";
	status = "okay";
};

&usbphy {
	usb0_id_det-gpios = <&pio 7 9 GPIO_ACTIVE_HIGH>; /* PH9 */
	usb0_vbus_power-supply = <&usb_power_supply>;
	usb0_vbus-supply = <&reg_drivevbus>;
	status = "okay";
};
